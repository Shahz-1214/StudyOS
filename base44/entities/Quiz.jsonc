{
  "name": "Quiz",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": "number"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "prompt",
          "options",
          "correct_index"
        ]
      },
      "default": []
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "ai"
      ],
      "default": "demo"
    },
    "source_resource_id": {
      "type": "string",
      "default": "",
      "description": "Canonical BoardResource textbook this quiz was grounded in. Empty for unconverted Note \u2192 Quiz and demo quizzes, so existing records are unaffected."
    },
    "source_chapter_id": {
      "type": "string",
      "default": "",
      "description": "TextbookChapter used as the grounding source for this quiz."
    },
    "source_book_title": {
      "type": "string",
      "default": ""
    },
    "source_chapter_title": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "subject_id",
    "title",
    "questions"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}