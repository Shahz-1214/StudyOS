{
  "name": "Essay",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "overall_score": {
      "type": "number",
      "default": 0
    },
    "analysis": {
      "type": "object",
      "default": {}
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "summary": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "title",
    "text"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}