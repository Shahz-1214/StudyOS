{
  "name": "MediaSecurityScan",
  "type": "object",
  "properties": {
    "file_uri": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "media_kind": {
      "type": "string",
      "enum": [
        "image",
        "audio"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "blocked",
        "error"
      ]
    },
    "provider": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "detected_count": {
      "type": "integer"
    },
    "error_code": {
      "type": "string"
    }
  },
  "required": [
    "file_uri",
    "owner_email",
    "media_kind",
    "status"
  ],
  "rls": {
    "create": false,
    "read": {
      "data.owner_email": "{{user.email}}"
    },
    "update": false,
    "delete": false
  }
}