{
  "name": "Event",
  "type": "object",
  "description": "Append-only analytics and quota-accounting ledger. Delete and update are admin-only so users cannot tamper with accounting rows (e.g. delete their own ai_request_started / media_scan_requested events to reset rate limits). Read and create remain owner-scoped: the Dashboard's activity feed reads its own events, and server quota guards write accounting events under the caller's identity \u2014 but those rows are then immutable from the client.",
  "properties": {
    "event_name": {
      "type": "string"
    },
    "properties": {
      "type": "object",
      "default": {}
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}