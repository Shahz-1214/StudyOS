{
  "name": "Board",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string"
    },
    "board": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": ""
    },
    "education_system": {
      "type": "string",
      "default": ""
    },
    "qualification": {
      "type": "string",
      "default": ""
    },
    "level": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "default": ""
    },
    "current_status": {
      "type": "string",
      "default": ""
    },
    "exam_window": {
      "type": "string",
      "default": ""
    },
    "requires_subboard": {
      "type": "boolean",
      "default": false
    },
    "sub_boards": {
      "type": "array",
      "default": [],
      "description": "Canonical sub-board registry for qualification-level boards such as Matric (SSC). Many provincial boards (BISE Punjab, BISE Lahore, FBISE) live under one qualification parent. Additive: resources and learners reference a sub_board_id while the parent board_id remains unchanged.",
      "items": {
        "type": "object",
        "properties": {
          "sub_board_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_board_id": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "default": ""
          },
          "country": {
            "type": "string",
            "default": ""
          },
          "curriculum_authority": {
            "type": "string",
            "default": ""
          },
          "curriculum_url": {
            "type": "string",
            "default": ""
          },
          "verified_on": {
            "type": "string",
            "format": "date"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "official_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "supplementary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "subject_rule": {
      "type": "string",
      "default": ""
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "failed",
        "unverified"
      ],
      "default": "verified"
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "provenance": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "board_id",
    "board"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}