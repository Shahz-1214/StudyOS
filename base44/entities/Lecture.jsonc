{
  "name": "Lecture",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "audio_url": {
      "type": "string",
      "default": ""
    },
    "transcript": {
      "type": "string",
      "default": ""
    },
    "summary": {
      "type": "string",
      "default": ""
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "flashcards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}