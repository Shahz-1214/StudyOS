{
  "name": "TextbookChapter",
  "type": "object",
  "description": "Canonical chapter record for an operator-supplied board textbook. References the canonical BoardResource textbook record (book_resource_id) \u2014 it never duplicates the PDF or the book metadata. Chapter boundaries are established deterministically (PDF outline, conservative table-of-contents detection, or an operator-supplied chapter map); when they cannot be established reliably the book stays not_indexed rather than guessing. Written only by the admin-only textbook backend functions; readable by authenticated learners because the canonical textbook is shared curriculum content (\u00a729).",
  "properties": {
    "book_resource_id": {
      "type": "string",
      "description": "Canonical BoardResource id of the textbook this chapter belongs to."
    },
    "board_id": {
      "type": "string",
      "default": ""
    },
    "sub_board_id": {
      "type": "string",
      "default": ""
    },
    "class_or_year": {
      "type": "string",
      "default": ""
    },
    "subject_name": {
      "type": "string",
      "default": ""
    },
    "medium": {
      "type": "string",
      "enum": [
        "english",
        "urdu",
        "unspecified"
      ],
      "default": "unspecified"
    },
    "chapter_index": {
      "type": "number",
      "description": "1-based position within the book, from the established chapter boundaries."
    },
    "chapter_title": {
      "type": "string"
    },
    "start_page": {
      "type": "number",
      "default": 0
    },
    "end_page": {
      "type": "number",
      "default": 0
    },
    "word_count": {
      "type": "number",
      "default": 0
    },
    "source_digest": {
      "type": "string",
      "default": "",
      "description": "Bounded, deterministically condensed representation of the chapter's own text, used as the grounding source for existing AI study features. Never AI-generated."
    },
    "source_text_uri": {
      "type": "string",
      "default": "",
      "description": "Private-storage URI of the full extracted chapter text (kept out of the record to respect field limits)."
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Official concepts established for this chapter. Empty until actually derived \u2014 never invented."
    },
    "derivation_method": {
      "type": "string",
      "enum": [
        "pdf_outline",
        "toc",
        "operator_map"
      ],
      "default": "pdf_outline"
    },
    "index_status": {
      "type": "string",
      "enum": [
        "indexed",
        "needs_review",
        "not_indexed"
      ],
      "default": "needs_review"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "needs_review",
        "unverified"
      ],
      "default": "needs_review"
    },
    "provenance": {
      "type": "string",
      "default": ""
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "book_resource_id",
    "chapter_index",
    "chapter_title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}