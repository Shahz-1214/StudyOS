{
  "name": "SubscriptionState",
  "type": "object",
  "description": "Server-managed entitlement record. Create/update/delete are admin-only so the plan/status fields can never be self-upgraded by the record owner. Paid tiers are granted only by a server-side source of truth (e.g. a verified purchase webhook); the absence of a record is treated as the free tier. Owner-read is retained so the user can view their own plan, but they cannot modify it.",
  "properties": {
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "elite"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "cancelled",
        "expired"
      ],
      "default": "active"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "plan"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}