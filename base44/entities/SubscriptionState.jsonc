{
  "name": "SubscriptionState",
  "type": "object",
  "description": "Server-managed entitlement record. Demo mode is an internal admin-only presentation entitlement and is never user-writable.",
  "properties": {
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "elite"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "cancelled",
        "expired"
      ],
      "default": "active"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "demo_mode": {
      "type": "boolean",
      "default": false,
      "description": "Internal admin-only Shipathon demo mode. Never writable by ordinary users."
    },
    "demo_activated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "plan"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}